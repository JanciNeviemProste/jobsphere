# Integration Test Environment Variables
# Copy this file to .env.test and update values as needed

# ============ DATABASE ============
# IMPORTANT: Use a separate test database to avoid corrupting dev data
# Add statement_timeout and connection_limit for production-like testing
# Option 1: Docker on different port
DATABASE_URL="postgresql://jobsphere:jobsphere_test@localhost:5433/jobsphere_test?statement_timeout=10000ms&connection_limit=25"

# Option 2: Different database name on same instance
# DATABASE_URL="postgresql://jobsphere:jobsphere_dev_2024@localhost:5432/jobsphere_test?statement_timeout=10000ms&connection_limit=25"

# ============ AUTHENTICATION ============
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="test-secret-key-for-integration-tests"

# ============ ENCRYPTION ============
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ============ FEATURE FLAGS ============
# Disable rate limiting in tests
DISABLE_RATE_LIMIT="true"

# Use log-only email service (no actual emails sent)
EMAIL_SERVICE="log"

# ============ EXTERNAL APIS ============
# Use test/mock keys for external services
ANTHROPIC_API_KEY="test-anthropic-key"
STRIPE_SECRET_KEY="sk_test_fake_key"
STRIPE_WEBHOOK_SECRET="whsec_test_fake_secret"

# ============ OPTIONAL SERVICES ============
# Redis (if needed for background jobs in tests)
# REDIS_URL="redis://localhost:6379/1"

# Upstash (rate limiting - disabled in tests)
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# File Upload (use local storage in tests)
# BLOB_READ_WRITE_TOKEN=""

# OCR Service (optional)
# ENABLE_OCR="false"
# OCR_SERVICE_URL="http://localhost:8000"

# Antivirus (optional)
# ENABLE_ANTIVIRUS="false"
# CLAMAV_HOST="localhost"
# CLAMAV_PORT="3310"

# ============ DEBUGGING ============
# Enable Prisma query logging
# DEBUG="prisma:query"

# ============ NOTES ============
# - Never commit .env.test with real credentials
# - Test database should be separate from development database
# - All external API calls should be mocked or disabled
# - Rate limiting should be disabled for faster tests
