# ===========================================
# JobSphere Environment Configuration
# ===========================================

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://jobsphere:jobsphere_dev_2024@localhost:5432/jobsphere

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Encryption (AES-256-GCM for OAuth tokens)
ENCRYPTION_KEY=generate-with-node-e-crypto-randomBytes-32-toString-hex

# AI Providers
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Redis (Upstash for rate limiting)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# REDIS_URL=redis://localhost:6379

# Email (resend | sendgrid | log)
EMAIL_SERVICE=log
# RESEND_API_KEY=
# SENDGRID_API_KEY=

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Stripe (optional)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Storage (local | vercel-blob)
STORAGE_PROVIDER=local
# BLOB_READ_WRITE_TOKEN=

# GDPR
GDPR_ADMIN_EMAIL=admin@yourdomain.com

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
